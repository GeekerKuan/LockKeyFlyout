<Window x:Class="LockKeyFlyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="160" Height="50" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="Transparent"
        TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border CornerRadius="11" BorderBrush="#5A5A5A" BorderThickness="1" Background="#D9232323" Padding="14,6,12,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Canvas Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Path Stroke="#FFFFFF" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M7.25,7.75 H16.75 A2.5,2.5 0 0 1 19.25,10.25 V17.75 A2.5,2.5 0 0 1 16.75,20.25 H7.25 A2.5,2.5 0 0 1 4.75,17.75 V10.25 A2.5,2.5 0 0 1 7.25,7.75 Z" />
                <Path Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8.75,7.75 V5.25 A3.25,3.25 0 0 1 15.25,5.25 V7.75">
                    <Path.RenderTransform><RotateTransform x:Name="ShackleTransform" CenterX="12" CenterY="7.75" /></Path.RenderTransform>
                </Path>
                <Ellipse Canvas.Left="10.5" Canvas.Top="12" Width="3" Height="3" Fill="White" />
                <Path Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,15 V17" />
            </Canvas>
            <TextBlock x:Name="MessageText" Grid.Column="1" Foreground="White" FontFamily="Microsoft YaHei UI" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0,0,4" TextOptions.TextRenderingMode="ClearType" />
            <Border x:Name="Indicator" Grid.Column="1" Width="36" Height="4" CornerRadius="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="2,0,0,0">
                <Border.Background><SolidColorBrush x:Name="IndicatorBrush" Color="#808080" /></Border.Background>
            </Border>
        </Grid>
    </Border>
</Window>
